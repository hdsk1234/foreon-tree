rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    match /apartments/{apartmentId} {
      allow read: if signedIn();
      match /complexes/{id} { allow read: if signedIn(); }
      match /buildings/{id} { allow read: if signedIn(); }
    }
    match /users/{uid} { allow get: if owner(uid); }
    match /events/{eventId} {
      allow read: if signedIn();
      match /participants/{uid} { allow get: if owner(uid); }
      match /userScores/{uid} { allow get: if owner(uid); }
      // 공개 문서에는 동별 집계만 포함한다.
      match /results/{id} { allow get: if id == 'leaderboard' || signedIn(); }
      // 개인정보 없는 동별 집계의 단건 조회만 허용. 목록 조회/쓰기 금지.
      match /teamScores/{buildingId} { allow get: if signedIn() || buildingId == '101'; }
    }
    // 모든 쓰기는 검증된 Admin SDK 함수만 수행한다.
    match /{document=**} { allow read, write: if false; }
  }
}
